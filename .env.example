# Required env for rarclean on TrueNAS.
# Place at /mnt/cell_block_d/apps/rarclean/.env (chmod 600).
# QBITTORRENT_PASSWORD is injected at runtime from Infisical.

INFISICAL_TOKEN=<universal-auth-access-token>
INFISICAL_PROJECT_ID=<project-uuid>
INFISICAL_ENV=prod
INFISICAL_DOMAIN=https://infisical.iillmaticc.link
